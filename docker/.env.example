# ========================================================================
# Puter Docker 部署配置
# 使用方式：cp .env.example .env 然后按需修改
# ========================================================================

# ---------- 访问配置 ----------
# 宿主机映射端口。改这里不要改容器内端口
PUTER_HTTP_PORT=4100

# 访问 Puter 的域名/主机
# 本机测试：puter.localhost 或 localhost
# 局域网：改成宿主机 IP，如 192.168.1.100
# 公网：改成你的域名，如 puter.example.com
PUTER_DOMAIN=puter.localhost

# 协议：本地 http 即可；走 HTTPS 反向代理时改成 https
PUTER_PROTOCOL=http

# 运行环境：production 或 dev
PUTER_ENV=production

# 管理员联系邮箱（会显示在系统里）
PUTER_CONTACT_EMAIL=admin@example.com

# ---------- 容器配置 ----------
# 时区，影响日志时间戳
TZ=Asia/Shanghai

# 容器名前缀，多实例部署时改这里避免冲突
COMPOSE_PROJECT_NAME=puter
